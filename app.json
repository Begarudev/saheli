{
  "expo": {
    "name": "Daily Mantras",
    "slug": "daily-mantras",
    "scheme": "dailymantras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1145"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailymantras.app"
    },
    "android": {
      "package": "com.dailymantras.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1145"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "SEND_SMS",
        "READ_PHONE_STATE",
        "READ_CONTACTS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Daily Mantras needs the microphone to record audio mantras."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Daily Mantras uses location to show the panchang for your area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Daily Mantras needs photos to attach to your prayer journal.",
          "cameraPermission": "Daily Mantras needs the camera to capture devotional moments."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Daily Mantras can pre-fill trusted contacts from your address book."
        }
      ]
    ],
    "extra": {
      "router": {},
      "sarvamApiKey": ""
    }
  }
}
